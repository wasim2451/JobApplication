<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  <div class="container mx-auto py-8">
    <h1 class="text-3xl font-bold text-center mb-6 text-gray-800">📊 Admin Dashboard</h1>

    <div class="overflow-x-auto bg-white shadow-lg rounded-lg">
      <table class="min-w-full table-auto border-collapse">
        <thead class="bg-gray-800 text-white">
          <tr>
            <th class="px-4 py-3 text-left">ID</th>
            <th class="px-4 py-3 text-left">Name</th>
            <th class="px-4 py-3 text-left">Email</th>
            <th class="px-4 py-3 text-left">Phone</th>
            <th class="px-4 py-3 text-left">DOB</th>
            <th class="px-4 py-3 text-left">Address</th>
            <th class="px-4 py-3 text-left">Position</th>
            <th class="px-4 py-3 text-left">Experience</th>
            <th class="px-4 py-3 text-left">Resume</th>
          </tr>
        </thead>
        <tbody class="text-gray-700">
          <% data.forEach(db => { %>
            <tr class="border-b hover:bg-gray-100">
              <td class="px-4 py-3"><%= db.ID %></td>
              <td class="px-4 py-3"><%= db.STUDENT_NAME %></td>
              <td class="px-4 py-3"><%= db.EMAIL %></td>
              <td class="px-4 py-3"><%= db.PHONE_NO %></td>
              <td class="px-4 py-3"><%= db.DOB %></td>
              <td class="px-4 py-3"><%= db.ADDRESS %></td>
              <td class="px-4 py-3"><%= db.POSITION %></td>
              <td class="px-4 py-3"><%= db.EXPERIENCE %></td>
              <td class="px-4 py-3 text-blue-600 underline">
                <a href="<%= db.RESUME_LINK %>" target="_blank">View</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</body>

</html>
